# ============================================
# GCP Authentication & Credentials
# ============================================
# Path to the service account JSON file for GCP authentication
# This file contains the private key and should NEVER be committed to git
# Copy your service account JSON file to this location
GOOGLE_APPLICATION_CREDENTIALS=src/config/service_account.json

# Alternative: Explicit path override if you want to use a different location
SERVICE_ACCOUNT_JSON_PATH=src/config/service_account.json

# ============================================
# GCP Project Configuration
# ============================================
# Your GCP project ID
GCP_PROJECT_ID=primal-result-478707-k2
GCP_REGION=us-central1

# ============================================
# BigQuery Configuration
# ============================================
# BigQuery dataset where your training data is located
BIGQUERY_DATASET=wed_scrape_sync
# Main table with training/property data
BIGQUERY_TRAIN_TABLE=master_listings
# Table where predictions will be stored
BIGQUERY_PREDICTIONS_TABLE=predictions

# ============================================
# Google Cloud Storage
# ============================================
# GCS bucket for storing models and preprocessors
GCS_BUCKET=linear_regression_model

# ============================================
# Application Configuration
# ============================================
# Environment: local, staging, production
ENVIRONMENT=local
# Enable debug mode
DEBUG=True
# Application name
APP_NAME=avm-project

# ============================================
# API Configuration
# ============================================
# Host and port for the API server
API_HOST=0.0.0.0
API_PORT=8080
# Number of worker processes
WORKERS=1
# API version
API_VERSION=1.0.0
# Maximum batch size for inference
MAX_BATCH_SIZE=100

# API Authentication (set to False for local development, True for production)
ENABLE_AUTH=False
# Header name for API key authentication
API_KEY_HEADER=X-API-Key
# API key for authentication (set only if ENABLE_AUTH=True)
API_KEY=

# ============================================
# Logging Configuration
# ============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# Training Configuration
# ============================================
# Random seed for reproducibility
RANDOM_SEED=42
# Test set fraction for train/test split
TRAIN_TEST_SPLIT_TEST_SIZE=0.2
# Random state for train/test split
TRAIN_TEST_SPLIT_RANDOM_STATE=42

# ============================================
# Geographic Bounds for Validation
# ============================================
# Used to validate property coordinates are within expected range
MIN_LATITUDE=4.0
MAX_LATITUDE=14.0
MIN_LONGITUDE=2.0
MAX_LONGITUDE=15.0

# ============================================
# Feature Engineering Configuration
# ============================================
# Maximum number of bedrooms/bathrooms before capping
BED_BATH_CAP=10

# ============================================
# Feature Flags
# ============================================
# Enable experimental features in development
ENABLE_EXPERIMENTAL_FEATURES=False
# Log all incoming API requests
ENABLE_REQUEST_LOGGING=True
# Enable profiling for performance analysis
ENABLE_PROFILING=False

# ============================================
# Model Artifacts Configuration
# ============================================
# Directories for storing local model artifacts
ARTIFACTS_DIR=./artifacts
MODELS_DIR=./artifacts/models
PREPROCESSORS_DIR=./artifacts/preprocessors
METADATA_DIR=./artifacts/metadata
